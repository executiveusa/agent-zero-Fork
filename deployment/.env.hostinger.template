# ═══════════════════════════════════════════════════════════════════════
# 🆓 FREE MODEL PROVIDERS (ZERO COST - HIGHLY RECOMMENDED)
# ═══════════════════════════════════════════════════════════════════════

# ── Google Gemini CLI (FREE via OAuth) ────────────────────────────────
# No API key needed! Uses free OAuth authentication
# Models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_CLI_ENABLED="true"
VERTEX_PROJECT="auto"          # Auto-detected from gcloud config
VERTEX_LOCATION="us-central1"  # Or your preferred region

# ── Antigravity (FREE via Vertex AI OAuth) ────────────────────────────
# Same as Gemini CLI but via Vertex AI endpoint
ANTIGRAVITY_ENABLED="true"

# ── Venice.ai (FREE tier available) ───────────────────────────────────
# Get free API key at: https://venice.ai
# Free tier: Generous limits for personal use
VENICE_API_KEY=""  # Optional: Add your Venice.ai API key

# ── OpenRouter (FREE models available) ────────────────────────────────
# Get key at: https://openrouter.ai
# Free models: google/gemini-2.0-flash-exp, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=""  # Optional: For free model access via OpenRouter


# ═══════════════════════════════════════════════════════════════════════
# 💰 PAID APIs (OPTIONAL - Only if you want premium models)
# ═══════════════════════════════════════════════════════════════════════

# ── Anthropic (Claude) - PAID ─────────────────────────────────────────
# Cost: ~$3 per million input tokens, ~$15 per million output tokens
# Only needed if you want Claude Opus/Sonnet instead of free models
ANTHROPIC_API_KEY=""  # Leave empty to use FREE models only

# ── OpenAI (GPT) - PAID ───────────────────────────────────────────────
# Cost: ~$2.50-$10 per million tokens depending on model
# Only needed if you want GPT-4 instead of free models
OPENAI_API_KEY=""  # Leave empty to use FREE models only


# ═══════════════════════════════════════════════════════════════════════
# 🤖 MODEL SELECTION (Using FREE models by default)
# ═══════════════════════════════════════════════════════════════════════

# Default model for general tasks (FREE)
DEFAULT_MODEL="gemini-2.0-flash"

# Planning and architecture (FREE)
PLANNING_MODEL="gemini-1.5-pro"

# Code generation (FREE)
CODING_MODEL="gemini-2.0-flash"

# Code review model (auto-selects opposing FREE model)
REVIEW_MODEL="auto"

# Primary model for committee review (FREE)
PRIMARY_MODEL="gemini-2.0-flash"


# ═══════════════════════════════════════════════════════════════════════
# 📱 TELEGRAM BOT (Mobile Control - FREE)
# ═══════════════════════════════════════════════════════════════════════

# Enable Telegram bot for mobile control
TELEGRAM_ENABLED="false"  # Set to "true" to enable

# Get bot token from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# Your Telegram user ID (get from: @userinfobot)
TELEGRAM_ADMIN_ID=""

# Optional: Additional authorized user IDs (comma-separated)
TELEGRAM_AUTHORIZED_USERS=""


# ═══════════════════════════════════════════════════════════════════════
# 🌐 GITHUB INTEGRATION (FREE)
# ═══════════════════════════════════════════════════════════════════════

# GitHub personal access token (for git sync, PR creation)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=""

# Your GitHub username
GITHUB_OWNER=""

# Repository name (e.g., "agent-zero-Fork")
GITHUB_REPO=""

# Default branch (usually "main")
GITHUB_BRANCH="main"

# Git sync settings
GIT_SYNC_ENABLED="true"
GIT_AUTO_PUSH="false"  # Manual control recommended


# ═══════════════════════════════════════════════════════════════════════
# 🔧 FEATURE TOGGLES (Cost Optimization)
# ═══════════════════════════════════════════════════════════════════════

# TTS (Text-to-Speech) - Uses lightweight espeak-ng (FREE)
TTS_ENABLED="true"
TTS_ENGINE="espeak-ng"  # Lightweight, no GPU needed

# Committee Review (Multi-model verification) - FREE when using free models
COMMITTEE_REVIEW_ENABLED="true"

# Browser Agent - DISABLED (high memory usage)
ENABLE_BROWSER_AGENT="false"

# ML Agent - DISABLED (requires GPU, high memory)
ENABLE_ML_AGENT="false"


# ═══════════════════════════════════════════════════════════════════════
# ⚡ PERFORMANCE SETTINGS (Optimized for Hostinger VPS)
# ═══════════════════════════════════════════════════════════════════════

# Maximum concurrent workers (2 for 512MB RAM VPS)
MAX_WORKERS="2"

# Memory limit in MB (leave ~100MB for system)
MEMORY_LIMIT_MB="400"

# Logging level (INFO recommended for production)
LOG_LEVEL="INFO"


# ═══════════════════════════════════════════════════════════════════════
# 🗄️ DATA PATHS
# ═══════════════════════════════════════════════════════════════════════

WORKSPACE_PATH="/workspace"
MEMORY_PATH="/memory"
LOGS_PATH="/logs"


# ═══════════════════════════════════════════════════════════════════════
# 🔐 ZENDESK INTEGRATION (Optional - If you need support ticketing)
# ═══════════════════════════════════════════════════════════════════════

ZENDESK_SUBDOMAIN=""     # Your Zendesk subdomain (e.g., "yourcompany")
ZENDESK_EMAIL=""         # Your Zendesk email
ZENDESK_API_KEY=""       # Zendesk API key


