# Never commit actual secrets
secrets.json
secrets.*.json
*.env
.env
.env.*

# Keys and credentials
.age-key.txt
*.key
*.pem
*.p12
*.pfx

# Decrypted files
*decrypted*
*plaintext*

# Backups
*.bak
*.backup

# Allow encrypted files and templates
!secrets.template.json
!*.encrypted.*
!*.enc
!*.age
!*.gpg
!*.asc

# Scripts and documentation (allow these)
!encrypt-secrets.sh
!decrypt-secrets.sh
!load-secrets.py
!README.md
!.gitignore
